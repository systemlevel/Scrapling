#!/bin/sh
# Reject vulnerable bundled/overridden Node before the browser driver runs.
set -eu
runtime="${SECURITY_NODE_PATH:-/usr/local/bin/security-node}"
"$runtime" -e 'const [major, minor, patch] = process.versions.node.split(".").map(Number); const floors = {22: [23, 4], 24: [22, 1], 26: [12, 1]}; const floor = floors[major]; if (!floor || minor < floor[0] || (minor === floor[0] && patch < floor[1])) { throw new Error("Browser driver requires patched Node >=22.23.4, >=24.22.1, or >=26.12.1 in its respective supported branch"); }'
exec "$runtime" "$@"
